{
  "name": "mobile-asset-translator",
  "version": "0.1.0",
  "description": "Command-line tool that translates iOS .strings and Android strings.xml files with Gemini and writes both formats.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "mobile-translate": "dist/main.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "translate": "npm run -s build && node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "cli-progress": "^3.12.0",
    "fast-xml-parser": "^5.12.0",
    "nest-commander": "^3.21.0",
    "picocolors": "^1.1.1",
    "plist": "^5.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
